# Supabase Configuration (frontend — prefix with VITE_ so Vite exposes them to the browser)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ──────────────────────────────────────────────────────────────
#  AI Navigator — Edge Function secrets (NOT browser variables)
#  Set these with:  supabase secrets set KEY=value
# ──────────────────────────────────────────────────────────────

# OpenRouter API key (get a free key at https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model to use — must support tool/function calling.
# Free options (verified 2026-05):
#   meta-llama/llama-3.3-70b-instruct:free  ← DEFAULT, best tool-calling free model
#   google/gemma-4-31b-it:free
#   nvidia/nemotron-3-super-120b-a12b:free
# Paid options: openai/gpt-4o-mini  |  anthropic/claude-3-haiku
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free